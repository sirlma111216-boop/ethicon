{
  "name": "festival-empty-seat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "축제의 빈자리: AI 배정위원회 — 중학교 AI 윤리 협력 수업 웹앱",
  "scripts": {
    "dev": "vite dev",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "build": "npm run check && npm run test && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "sim": "node scripts/sim.mjs",
    "images": "node scripts/optimize-images.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
        "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1",
    "ws": "8.22.1"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "workerd@1.20261101.1": true,
    "esbuild@0.28.2": true
  }
}
